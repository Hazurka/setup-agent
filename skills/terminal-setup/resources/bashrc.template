# ===================================================================
# Bash Interactive Configuration (~/.bashrc)
# ===================================================================

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Ensure PATH has Homebrew & local binaries in subshells
if [[ -z "$HOMEBREW_PREFIX" && -x "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -z "$HOMEBREW_PREFIX" && -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
[[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && export PATH="$HOME/.local/bin:$PATH"

# -------------------------------------------------------------------
# History Configuration
# -------------------------------------------------------------------
HISTFILE="$HOME/.bash_history"
HISTSIZE=10000
HISTFILESIZE=10000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
shopt -s checkwinsize

# -------------------------------------------------------------------
# Aliases: eza (modern ls) & navigation
# -------------------------------------------------------------------
if command -v eza &>/dev/null; then
  alias ls="eza --icons=auto --group-directories-first"
  alias l="eza -lh --icons=auto --group-directories-first --git --header"
  alias ll="eza -lah --icons=auto --group-directories-first --git --header"
  alias la="eza -a --icons=auto --group-directories-first"
  alias lt="eza --tree --level=2 --icons=auto"
  alias ltree="eza --tree --icons=auto"
else
  alias ls="ls --color=auto"
  alias ll="ls -lah --color=auto"
fi

# Quick navigation & shortcuts
alias ..="cd .."
alias ...="cd ../.."
alias reload="source ~/.bashrc"

# Ghostty terminal compatibility (fallback terminfo for remote SSH hosts)
if [[ "$TERM" == "xterm-ghostty" ]]; then
  alias ssh="TERM=xterm-256color ssh"
fi

# -------------------------------------------------------------------
# Ghostty Shell Integration (semantic prompts, jumping between marks)
# -------------------------------------------------------------------
if [[ -n "$GHOSTTY_RESOURCES_DIR" && -f "$GHOSTTY_RESOURCES_DIR/shell-integration/bash/ghostty-integration" ]]; then
  builtin source "$GHOSTTY_RESOURCES_DIR/shell-integration/bash/ghostty-integration"
fi

# -------------------------------------------------------------------
# Prompt: Starship
# -------------------------------------------------------------------
if command -v starship &>/dev/null; then
  eval "$(starship init bash)"
fi
